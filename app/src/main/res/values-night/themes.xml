<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.BLESM" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Material 3 color roles are already defined in values/themes.xml
             and will use colors from values-night/colors.xml -->

        <!-- For Dark Theme, status bar icons should be light -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <!-- Other dark theme specific overrides if necessary -->
    </style>

    <!-- If you keep the explicit overlays, ensure they have corresponding -night versions or use M3 DayNight overlays -->
    <style name="Theme.BLESM.AppBarOverlay" parent="ThemeOverlay.Material3.Dark.ActionBar" />
    <!-- PopupOverlay is usually light, so this might remain ThemeOverlay.Material3.Light or you might need a dark version if popups can be dark -->

</resources>